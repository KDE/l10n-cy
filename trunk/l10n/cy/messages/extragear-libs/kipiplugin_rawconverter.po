msgstr ""

#: dcrawsettingswidget.cpp:151
msgid "Solid white"
msgstr ""

#: dcrawsettingswidget.cpp:152
msgid "Unclip"
msgstr ""

#: dcrawsettingswidget.cpp:153
msgid "Reconstruct"
msgstr ""

#: dcrawsettingswidget.cpp:154
msgid ""
"<p><b>Highlights clipping</b>"
"<p>Select here the highlight cliping method:<b>Solid white</b>"
": clip all highlights to solid white"
"<p><b>Unclip</b>: leave highlights unclipped in various shades of pink"
"<p><b>Reconstruct</b>: reconstruct highlights using a level. Low value favor "
"whites and high value favor colors."
msgstr ""

