#: xml_doc.cc:2940
#, no-c-format
msgid "On most systems, this returns 2^-52=2.2204460492503131e-16"
msgstr ""
"Ar y rhan fwyaf o gysodau, mae hyn yn dychwelyd 2^-52=2.2204460492503131e-16"

#. i18n: file extensions/math.xml line 115
#: xml_doc.cc:2943
#, no-c-format
msgid ""
