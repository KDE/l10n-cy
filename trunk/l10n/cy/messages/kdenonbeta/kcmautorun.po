#: kcmautorun.cpp:224
msgid "Helpful information about the kcmautorun module."
msgstr ""

#. i18n: file kcmautorunbase.ui line 17
#: rc.cpp:3
#, no-c-format
msgid "KDE Autorun"
msgstr ""

#. i18n: file kcmautorunbase.ui line 31
#: rc.cpp:6
#, no-c-format
msgid "&Enable KDE Autorun."
msgstr ""

#. i18n: file kcmautorunbase.ui line 34
#: rc.cpp:9
#, no-c-format
msgid "Alt+E"
msgstr ""

#. i18n: file kcmautorunbase.ui line 40
#: rc.cpp:12
#, no-c-format
msgid ""
"This option sets whether you want KDE to automatically detect media insertions. "
"If you turn it off KDE will never do anything automatically when you insert a "
"disk."
msgstr ""

#. i18n: file kcmautorunbase.ui line 48
#: rc.cpp:15
#, no-c-format
msgid "Multimedia Disks"
msgstr ""

#. i18n: file kcmautorunbase.ui line 67
#: rc.cpp:18
#, no-c-format
msgid "&Disk type:"
msgstr ""

#. i18n: file kcmautorunbase.ui line 92
#: rc.cpp:21
#, no-c-format
msgid ""
"This is the type of media that you would like to configure an action for below."
msgstr ""

#. i18n: file kcmautorunbase.ui line 117
#: rc.cpp:24
#, no-c-format
msgid "Action To Take Upon Detection"
msgstr ""

#. i18n: file kcmautorunbase.ui line 136
#: rc.cpp:27
#, no-c-format
msgid "These are the actions the KDE knows about. Please select one."
msgstr ""

#. i18n: file kcmautorunbase.ui line 146
#: rc.cpp:30
#, no-c-format
msgid "Data Disks"
msgstr ""

#. i18n: file kcmautorunbase.ui line 157
#: rc.cpp:33
#, no-c-format
msgid "Automatically &mount device (recommended)."
msgstr ""

#. i18n: file kcmautorunbase.ui line 160
#: rc.cpp:36
#, no-c-format
msgid "Alt+M"
msgstr ""

#. i18n: file kcmautorunbase.ui line 163
#: rc.cpp:39
#, no-c-format
msgid ""
"Enabling this option will mean that a data disk's files will automatically be "
"made available when you insert the disk. This must be enabled for several other "
"useful features, below."
msgstr ""

#. i18n: file kcmautorunbase.ui line 199
#: rc.cpp:42
#, no-c-format
msgid "Open a &browsing window insde the device."
msgstr ""

#. i18n: file kcmautorunbase.ui line 202
#: rc.cpp:45
#, no-c-format
msgid "Alt+B"
msgstr ""

#. i18n: file kcmautorunbase.ui line 205
#: rc.cpp:48
#, no-c-format
msgid ""
"Enabling this feature means KDE will automatically open an appropriate browser "
"window when you insert media that contain files."
msgstr ""

#. i18n: file kcmautorunbase.ui line 243
#: rc.cpp:51
#, no-c-format
msgid "Open a &terminal session inside the device."
msgstr ""

#. i18n: file kcmautorunbase.ui line 246
#: rc.cpp:54
#, no-c-format
msgid "Alt+T"
msgstr ""

#. i18n: file kcmautorunbase.ui line 249
#: rc.cpp:57
#, no-c-format
msgid ""
"Enabling this option means KDE will open a Konsole when you insert media that "
"contain files."
msgstr ""

#. i18n: file kcmautorunbase.ui line 287
#: rc.cpp:60
#, no-c-format
msgid "Allow automatic starting of a &program disk (recommended)."
msgstr ""

#. i18n: file kcmautorunbase.ui line 290
#: rc.cpp:63
#, no-c-format
msgid "Alt+P"
msgstr ""

#. i18n: file kcmautorunbase.ui line 293
#: rc.cpp:66
#, no-c-format
msgid ""
"Enabling this option means the KDE will automatically start programs on some "
"disks. Such disks include some game and application disks."
msgstr ""

#. i18n: file kcmautorunbase.ui line 331
#: rc.cpp:69
#, no-c-format
msgid "Allow automatic starting of single audio/&video content (recommended)."
msgstr ""

#. i18n: file kcmautorunbase.ui line 334
#: rc.cpp:72
#, no-c-format
msgid "Alt+V"
msgstr ""

#. i18n: file kcmautorunbase.ui line 337
#: rc.cpp:75
#, no-c-format
msgid ""
"Enabling this option means the KDE will automatically start audio/video on "
"disks that have one such media file on them."
msgstr ""

#. i18n: file kcmautorunbase.ui line 350
#: rc.cpp:78
#, no-c-format
msgid "Maintain an &icon on the desktop while the disk is inserted."
msgstr ""

#. i18n: file kcmautorunbase.ui line 353
#: rc.cpp:81
#, no-c-format
msgid "Alt+I"
msgstr ""

#. i18n: file kcmautorunbase.ui line 356
#: rc.cpp:84
#, no-c-format
msgid ""
"Enabling this option will make KDE put an appropriate icon on your desktop when "
"you insert media that contain files. It is removed when you remove the medium "
"in question."
msgstr ""
