msgstr "Gwerth"

#: configparser.cpp:483
msgid ""
"No hardware architecture was specified. Perhaps the kernel source code is not "
"installed on this system, or the path to the kernel sources is entered "
"incorrectly."
msgstr ""

#: configparser.cpp:493
msgid "Linux kernel versions 2.5 and above are not yet supported."
msgstr "Ni chynhelir fersiynau 2.5 ac uwch o gnewyllyn Linux eto."

#: configparser.cpp:676
msgid "cannot open %1 for reading"
msgstr "Methu agor %1 ar gyfer darllen"

#: configuration.cpp:98
msgid ""
"Are you sure you want to overwrite your existing kernel configuration in %1?"
msgstr ""
"Ydych chi'n sicr eich bod chi eisiau trosysgrifo eich ffurfweddiad gnewyllyn "
"bresennol yn %1?"

#: configuration.cpp:111
msgid ""
"You do not have sufficient permissions to write to %1\n"
"Do you want to write the configuration to a different file instead?"
msgstr ""
"Nid oes gennych freintiau digonol i sgwennu i %1\n"
" Ydych chi eisiau sgwennu'r ffurweddiad i ffeil arall yn lle?"

#: configuration.cpp:123
msgid "Do you really want to reset all kernel options to their default values?"
msgstr ""
"Ydych wir eisiau ailosod dewisiadau'r cnewyllyn i gyd i'w gwerthoedd "
"rhagosodedig?"

#: configuration.cpp:149
msgid ""
"_: Error message\n"
"<p>%1</p>"
msgstr ""
"Neges gwall\n"
"<p>%1</p>"

#: configuration.cpp:155
msgid ""
"<p>%1, line %2:</p>\n"
"<pre>%3<span style=\"color: red\">%4</span>%5\n"
"%6^ %7</pre>"
msgstr ""
"<p>%1, llinell %2:</p>\n"
" "
"<pre>%3<span style=\"color: red\">%4</span>%5\n"
" %6^ %7</pre>"

#: configuration.cpp:168
msgid ""
"<p>Either your kernel sources contain invalid configuration rules or you just "
"found a bug in the KDE Kernel Configurator.</p>"
msgstr ""
"<p>Mae tarddiadau eich cnewyllyn yn cynnwys rheolau ffurfweddu annilys, neu "
"rydych chi newydd ganfod nam yn Ffurfweddydd Cnewyllyn KDE.</p>"

#: configuration.cpp:184
msgid "The kernel configuration could not be read due to the following error:"
msgstr "Ni ellid darllen ffurfweddiad y cnewyllyn o achos y gwall canlynol:"

#: configuration.cpp:185
msgid "The kernel configuration could not be read due to the following errors:"
msgstr "Ni ellid darllen ffurfweddiad y cnewyllyn o achos y gwallau canlynol:"

#: configuration.cpp:239
msgid "Linux Kernel Configurator"
msgstr "Ffurfweddyd Cnewyllyn Linux"

#: configuration.cpp:240
msgid "Option is disabled"
msgstr "Analluogir y dewisiad"

#: configuration.cpp:241
msgid "Option is enabled"
msgstr "Alluogir y dewisiad"

#: configuration.cpp:242
msgid "Compiled as a module"
msgstr "Wedi'i grynhoi fel modiwl"

#: configuration.cpp:327
msgid ""
"Your kernel configuration has been saved.\n"
"You need to run 'make symlinks dep' now."
msgstr ""
"Cadwyd ffurfweddiad eich cnewyllyn.\n"
" Yr ydych angen rhedeg 'make symlinks dep' yn awr."

#: configuration.cpp:331
msgid ""
"Your kernel configuration has been saved.\n"
"You may run 'make bzImage', 'make bzDisk' or 'make install' now."
msgstr ""
"Cadwyd ffurfweddiad eich cnewyllyn.\n"
" Cewch redeg 'make bzImage', 'make bzDisk' neu 'make install' yn awr."

#: configuration.cpp:337
msgid ""
"Your kernel configuration has been saved.\n"
"The file %1, which is needed for the kernel build could not be written though.\n"
"Please run 'make oldconfig'."
msgstr ""
"Cadwyd ffurfweddiad eich cnewyllyn.\n"
" Ond ni ellid ysgrifennu'r ffeil %1 sydd ei angen ar gyfer adeiladu'r "
"cnewyllyn.\n"
" Rhedwch 'make oldconfig'."

#: configuration.cpp:344
msgid "Your kernel configuration has been saved."
msgstr "Cadwyd ffurfweddiad eich cnewyllyn."

#: configuration.cpp:349
msgid "The kernel configuration could not be saved."
msgstr "Ni ellid cadw ffurfweddiad eich cnewyllyn."

