#: options.cpp:223
msgid ""
"usage: %1 [-options] [message ...]\n"
"\n"
msgstr ""

#: options.cpp:225
msgid ""
"where options include:\n"
msgstr ""

#: options.cpp:226
msgid ""
"  -title name             the title used on the message window\n"
msgstr ""

#: options.cpp:227
msgid ""
"  -file filename          file to read message from, \"-\" for stdin\n"
msgstr ""

#: options.cpp:228
msgid ""
"  -buttons string         comma-separated list of label[:exitcode]\n"
msgstr ""

#: options.cpp:229
msgid ""
"  -default button         button to activate if Return is pressed\n"
msgstr ""

#: options.cpp:230
msgid ""
"  -cancel button          button to activate if Escape is pressed\n"
msgstr ""

#: options.cpp:231
msgid ""
"  -print                  print the button label when selected\n"
msgstr ""

#: options.cpp:232
msgid ""
"  -escape                 expand \\n,\\r, and \\t characters in message\n"
msgstr ""

#: options.cpp:233
msgid ""
"  -timeout secs           exit with status 0 after \"secs\" seconds\n"
"\n"
msgstr ""

#: options.cpp:235
msgid ""
"the following options are allowed for compatibility, but are non-functional:\n"
msgstr ""

#: options.cpp:236
msgid ""
"  -center\n"
msgstr ""

#: options.cpp:237
msgid ""
"  -nearmouse\n"
"\n"
msgstr ""

