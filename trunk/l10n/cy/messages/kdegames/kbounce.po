#: kbounce.cpp:133
msgid "&Select Background Folder..."
msgstr "&Dewis Plygell Gefndir..."

#: kbounce.cpp:136
msgid "Show &Backgrounds"
msgstr "Dangos &Cefndiroedd"

#: kbounce.cpp:138
msgid "Hide &Backgrounds"
