#: kexi/kexidb/drivers/mySQL/showimg_kexidb_mysqldriver.desktop:3
msgid "Name=mySQL"
msgstr "Name=mySQL"

#: kexi/kexidb/drivers/mySQL/showimg_kexidb_mysqldriver.desktop:5
msgid ""
"Comment=mySQL is a fast database engine. It is used for personal purposes as "
"well as for huge databases in big companies and organizations. We recommend "
"using mySQL for projects shared in networks."
msgstr ""
"Comment=Peiriant cronfa ddata cyflym yw mySQL.  Defnyddir ar gyfer pwrpasau "
"personol yr un pryd ac ar gyfer cronfeydd data enfawr mewn cwmniau a mudiadau "
"mawr.  Argymhellir defnyddio mySQL ar gyfer cyweithiau a rannir dros "
"rwydweithiau."

