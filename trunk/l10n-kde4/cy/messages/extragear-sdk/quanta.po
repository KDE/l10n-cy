"The <b>DIV ALIGN</b>=<i>right</i>\n"
"     suggests the horizontal alignment for the content of the division to "
"<i>right</i>.\n"
"   "
msgstr ""

#. i18n: file: extrafiles2:603
#. i18n: file: extrafiles2:1199
#. i18n: file: extrafiles2:603
#. i18n: file: extrafiles2:1199
#: rc.cpp:3606 rc.cpp:3708
