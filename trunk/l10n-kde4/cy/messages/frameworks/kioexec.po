#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec - Agor ffeiliau pell, arsylwi newidiadau, gofyn am lanlwytho"

#: main.cpp:80
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"Mae'r URL %1\n"
"wedi'i gam-fformatio"

#: main.cpp:82
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Ni chaniateir URL pell %1\n"
"efo'r cymal --tempfiles"

#: main.cpp:213
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Mae'r ffeil\n"
"%1\n"
"(oedd i fod dros dro) wedi ei newid. \n"
"Ydych eisiau ei dileu?"

#: main.cpp:214 main.cpp:221
msgid "File Changed"
msgstr "Newidwyd y ffeil."

#: main.cpp:214
msgid "Do Not Delete"
msgstr ""

#: main.cpp:220
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Mae'r ffeil\n"
"%1\n"
"wedi ei newid. \n"
"Ydych eisiau lanlwytho'r newidiadau?"

#: main.cpp:221
msgid "Upload"
msgstr "Lanlwytho"

#: main.cpp:221
