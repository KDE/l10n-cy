#. i18n: file positiontab.ui line 17
#: rc.cpp:622
#, no-c-format
msgid ""
"This is a list of all the panels currently active on your desktop. Select "
"one to configure."
msgstr ""
"Dyma restr holl baneli gweithredol eich penbwrdd. Dewiswch un i'w ffurfweddu."

