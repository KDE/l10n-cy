#: kthememanager.cpp:254
#, qt-format
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "Ydych wir eisiau gwaredu'r thema <b>%1</b>?"

#: kthememanager.cpp:255
msgid "Remove Theme"
msgstr "Gwaredu Thema"

#: kthememanager.cpp:277
msgid "My Theme"
msgstr "Fy Thema"

