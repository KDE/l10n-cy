#: xml_doc.cpp:4646
msgid "TOGGLE(\"hello\") returns \"HELLO\""
msgstr "Mae TOGGLE(\"helo\") yn dychwelyd \"HELO\""

#. i18n: file: functions/text.xml:427
#: xml_doc.cpp:4648
msgid "TOGGLE(\"HELLO\") returns \"hello\""
msgstr "Mae TOGGLE(\"HELO\") yn dychwelyd \"helo\""

