msgid "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";1) returns \"Qtr 3, 2001\""
msgstr ""
"Mae SUBSTITUTE(\"Chw 1, 2001\";\"1\";\"3\";1) yn dychwelyd \"Chw 3, 2001\""

