#: kcmautorun.cpp:224
msgid "Helpful information about the kcmautorun module."
msgstr ""

#: rc.cpp:2
#, no-c-format
msgid "KDE Autorun"
msgstr ""

#: rc.cpp:4
#, no-c-format
msgid "&Enable KDE Autorun."
msgstr ""

#: rc.cpp:6
#, no-c-format
msgid "Alt+E"
msgstr ""

#: rc.cpp:8
#, no-c-format
msgid ""
"This option sets whether you want KDE to automatically detect media "
"insertions. If you turn it off KDE will never do anything automatically when "
"you insert a disk."
msgstr ""

#: rc.cpp:10
#, no-c-format
msgid "Multimedia Disks"
msgstr ""

#: rc.cpp:12
#, no-c-format
msgid "&Disk type:"
msgstr ""

#: rc.cpp:14
#, no-c-format
msgid ""
"This is the type of media that you would like to configure an action for "
"below."
msgstr ""

#: rc.cpp:16
#, no-c-format
msgid "Action To Take Upon Detection"
msgstr ""

#: rc.cpp:18
#, no-c-format
msgid "These are the actions the KDE knows about. Please select one."
msgstr ""

#: rc.cpp:20
#, no-c-format
msgid "Data Disks"
msgstr ""

#: rc.cpp:22
#, no-c-format
msgid "Automatically &mount device (recommended)."
msgstr ""

#: rc.cpp:24
#, no-c-format
msgid "Alt+M"
msgstr ""

#: rc.cpp:26
#, no-c-format
msgid ""
"Enabling this option will mean that a data disk's files will automatically "
"be made available when you insert the disk. This must be enabled for several "
"other useful features, below."
msgstr ""

#: rc.cpp:28
#, no-c-format
msgid "Open a &browsing window insde the device."
msgstr ""

#: rc.cpp:30
#, no-c-format
msgid "Alt+B"
msgstr ""

#: rc.cpp:32
#, no-c-format
msgid ""
"Enabling this feature means KDE will automatically open an appropriate "
"browser window when you insert media that contain files."
msgstr ""

#: rc.cpp:34
#, no-c-format
msgid "Open a &terminal session inside the device."
msgstr ""

#: rc.cpp:36
#, no-c-format
msgid "Alt+T"
msgstr ""

#: rc.cpp:38
#, no-c-format
msgid ""
"Enabling this option means KDE will open a Konsole when you insert media "
"that contain files."
msgstr ""

#: rc.cpp:40
#, no-c-format
msgid "Allow automatic starting of a &program disk (recommended)."
msgstr ""

#: rc.cpp:42
#, no-c-format
msgid "Alt+P"
msgstr ""

#: rc.cpp:44
#, no-c-format
msgid ""
"Enabling this option means the KDE will automatically start programs on some "
"disks. Such disks include some game and application disks."
msgstr ""

#: rc.cpp:46
#, no-c-format
msgid "Allow automatic starting of single audio/&video content (recommended)."
msgstr ""

#: rc.cpp:48
#, no-c-format
msgid "Alt+V"
msgstr ""

#: rc.cpp:50
#, no-c-format
msgid ""
"Enabling this option means the KDE will automatically start audio/video on "
"disks that have one such media file on them."
msgstr ""

#: rc.cpp:52
#, no-c-format
msgid "Maintain an &icon on the desktop while the disk is inserted."
msgstr ""

#: rc.cpp:54
#, no-c-format
msgid "Alt+I"
msgstr ""

#: rc.cpp:56
#, no-c-format
msgid ""
"Enabling this option will make KDE put an appropriate icon on your desktop "
"when you insert media that contain files. It is removed when you remove the "
"medium in question."
msgstr ""
