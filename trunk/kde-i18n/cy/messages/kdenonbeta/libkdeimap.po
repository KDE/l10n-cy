#: imaplogin.cpp:99
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Nid yw'r gweinydd %1 yn cynnal na IMAP4 na IMAP4rev1.\n"
"Dynododd ei hun â %2"

#: imaplogin.cpp:115
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Nid yw'r gweinydd yn cynnal TLS.\n"
"Analluogwch y nodwedd diogelwch yma i gysylltu heb gêl-ysgrifaeth."

#: imaplogin.cpp:142
msgid "Starting TLS failed."
msgstr "Methodd cychwyn TLS."

#: imaplogin.cpp:151
msgid "The authentication method %1 is not supported by the server."
msgstr "Ni chynhelir y dull awdurdodi %1 gan y gweinydd."

#: imaplogin.cpp:160
msgid "Username and password for your IMAP account:"
msgstr ""

#: imaplogin.cpp:172
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or try to get a "
"different username."
msgstr ""

#: imaplogin.cpp:178
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or change your "
"password."
msgstr ""
"Mewn mewngofnod testun plaen IMAP, dim ond nôdau ASCII'r UDau sy'n bosib. "
"Defnyddiwch dull awdurdodi arall y cynhelir gan eich gweinydd neu newidiwch "
"eich cyfrinair."

#: imaplogin.cpp:191
msgid ""
"Unable to authenticate via %1.\n"
"The server does not support this authentication method (as specified in its "
"CAPABILITY response)."
msgstr ""

#: imaplogin.cpp:206
#, c-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Methu mewngofnodi. Mae'n debyg fod y cyfrinair yn anghywir.\n"
"Atebodd y gweinydd:\n"
"%1"

#: imaplogin.cpp:236
msgid ""
"Unable to authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Methu awdurdodi drwy %1.\n"
"Atebodd y gweinydd:\n"
"%2"

#: imapselect.cpp:167
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Methu agor y blygell %1. Atebodd y gweinydd: %2"

#: imapstat.cpp:132
msgid "Unable to close mailbox."
msgstr "Methu cau'r blwch post."

#: imapstat.cpp:180
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Methu cael gwybodaeth am blygell %1. Ymatebodd y gweinydd: %2"

#: imapstatus.cpp:59 imapstatus.cpp:72
msgid "Changing the flags of message %1 failed."
msgstr "Methodd newid baneri neges %1."

#: imapsubscribe.cpp:56
msgid "Unsubscribe of folder %1 failed."
msgstr ""

#: imapsubscribe.cpp:60
msgid "Subscribe of folder %1 failed."
msgstr ""
