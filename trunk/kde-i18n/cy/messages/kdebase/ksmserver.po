#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Owain Green ar ran KGyfieithu - Meddalwedd Gymraeg"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "kyfieithu@dotmon.com"

#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Y trefnydd sesiynau dibynadwy KDE sy'n siarad protocol safonol \n"
"trefnu sesiynau X11R6 (XSMP)."

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr "Adfera'r sesiwn defnyddiwr wedi'i gadw os ar gael"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Dechreua 'wm' rhag ofn na bod trefnydd ffenestri arall \n"
"yn cymeryd rhan yn y sesiwn. 'kwin' yw'r rhagosodyn."

#: main.cpp:38
msgid "Also allow remote connections."
msgstr "Caniatáu cysylltiadau pell hefyd."

#: main.cpp:176
msgid "The KDE Session Manager"
msgstr "Trefnydd Sesiynau KDE"

#: shutdown.cpp:82
msgid "End Session for \"%1\""
msgstr "Diwedd Sesiwn ar gyfer \"%1\""

#: shutdown.cpp:106
msgid "What do you want to do next?"
msgstr "Beth ydych am ei wneud nesaf?"

#: shutdown.cpp:107
msgid "&Login as different user"
msgstr "&Mewngofnodi fel defnyddiwr gwahanol"

#: shutdown.cpp:108
msgid "&Turn off computer"
msgstr "&Diffodd y cyfrifiadur"

#: shutdown.cpp:109
msgid "&Restart computer"
msgstr "&Ailgychwyn y cyfrifiadur"

#: shutdown.cpp:130
msgid "Shutdown Mode"
msgstr "Modd Cau i Lawr"

#: shutdown.cpp:131
msgid "Sch&edule"
msgstr "Tr&efnlennu"

#: shutdown.cpp:133
msgid "&Force now"
msgstr "&Gorfodi nawr"

#: shutdown.cpp:134
msgid "&Try now"
msgstr "&Ceisio nawr"

#: shutdown.cpp:145
msgid "&Logout"
msgstr "&Allgofnodi"

