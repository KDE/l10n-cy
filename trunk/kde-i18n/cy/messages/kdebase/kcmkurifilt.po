msgstr "Ychwanegu darparwr chwiliadau."

#: plugins/ikws/ikwsopts.cpp:139
msgid "Chan&ge..."
msgstr "N&ewid..."

#: plugins/ikws/ikwsopts.cpp:140
msgid "Modify a search provider."
msgstr "Addasu darparwr chwiliadau."

#: plugins/ikws/ikwsopts.cpp:144
msgid "De&lete"
msgstr "Di&leu"

#: plugins/ikws/ikwsopts.cpp:145
