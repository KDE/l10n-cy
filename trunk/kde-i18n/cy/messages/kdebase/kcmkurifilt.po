msgid "Import..."
msgstr "Mewnforio..."

#: plugins/ikws/ikwsopts.cpp:151
msgid "Click here to import a search provider from a file."
msgstr "Cliciwch yma i fewnforio darparwr chwiliadau o ffeil."

