#: arts.cpp:85
msgid ""
" Unable to start aRts sound server to retrieve possible sound I/O methods.\n"
" Only automatic detection will be available.\n"
msgstr ""
"Methu dechrau gweinydd sain aRts i nôl dulliau M/A sain posib.\n"
" Canfod ymysgogol yn unig fydd ar gael.\n"

#: arts.cpp:201
