#: debugger.cpp:132
msgid "Unable to create a valid backtrace."
msgstr "Methu creu olrheiniad dilys."

#: debugger.cpp:133
msgid ""
"This backtrace appears to be useless.\n"
"This is probably because your packages are built in a way which prevents "
"creating of proper backtraces, or the stack frame was seriously corrupted in "
"the crash.\n"
"\n"
msgstr ""
"Ymddengys na ellir defnyddio'r olrheiniad yma.\n"
"Mwy na thebyg, yr achos yw bod eich pecynnau yn cael eu adeiladu mewn ffordd "
"sy'n atal creu olrheiniadau iawn, neu roedd ffrâm pentwr yn cael ei lygru "
"yn y chwalfa.\n"
"\n"

#: debugger.cpp:142
