#: kthememanager.cpp:154 kthememanager.cpp:403
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr "Mae'r modiwl rheoli yma yn trin arsefydlu, gwaredu a chreu themau KDE gweledol."

#: kthememanager.cpp:199
msgid "Theme Files"
msgstr "Ffeiliau Thema"

#: kthememanager.cpp:200
msgid "Select Theme File"
msgstr "Dewis Ffeil Thema"

#: kthememanager.cpp:233
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "Ydych wir eisiau gwaredu'r thema <b>%1</b>?"

#: kthememanager.cpp:234
msgid "Remove Theme"
msgstr "Gwaredu Thema"

#: kthememanager.cpp:255
msgid "My Theme"
msgstr "Fy Thema"

#: kthememanager.cpp:266
msgid "Theme %1 already exists."
msgstr "Mae thema %1 mewn bod eisoes."

#: kthememanager.cpp:285
#, c-format
msgid "Your theme has been successfully created in %1."
msgstr "Creuwyd eich thema yn lwyddiannus yn %1."

#: kthememanager.cpp:286
msgid "Theme Created"
msgstr "Creuwyd Thema"

#: kthememanager.cpp:288
msgid "An error occurred while creating your theme."
msgstr "Digwyddodd gwall wrth greu eich thema."

#: kthememanager.cpp:289
