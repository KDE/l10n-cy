#: kio_floppy.cpp:200
#, fuzzy
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"gyrrwr %1.\n"
"Mae'r gyrrwr dal yn brysur.\n"
"Arhoswch nes ei fod wedi gorffen gweithio wedyn ceisiwch eto."

#: kio_floppy.cpp:204 kio_floppy.cpp:1146
#, fuzzy
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"\n"
"Mae'n debyg fo'r ddisg yng ngyrrwr %1 yn llawn."

#: kio_floppy.cpp:214
#, fuzzy
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"\n"
"Mae'n debyg na fo disg yng ngyrrwr %1"

#: kio_floppy.cpp:218
#, fuzzy
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"\n"
"Mae'n debyg na fo disg yng ngyrrwr %1 neu nad oes gennych ddigon o "
"ganiatadau i hygyrchu'r gyrrwr."

#: kio_floppy.cpp:222
#, fuzzy
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"\n"
"Ni chynhelir y gyrrwr %1."

#: kio_floppy.cpp:227
#, fuzzy
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"\n"
"Sicrhewch bod y llipäen yng ngyrrwr %1 yn ddisg llipa â fformat DOS \n"
"a bod caniatadau'r ffeil ddyfais (e.e. /def/fd0) wedi'u gosod yn gywir (e.e. "
"rwxrwxrwx)."

#: kio_floppy.cpp:231
#, fuzzy
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"\n"
"Mae'n debyn nad disg llipa â fformat DOS yw'r ddisg yng ngyrrwr %1."

#: kio_floppy.cpp:235
#, fuzzy
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"\n"
"Mae'n debyg fod y ddisg yng ngyrrwr %1 wedi'i diogelu rhag ysgrifennu."

#: kio_floppy.cpp:244
#, fuzzy
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"\n"
"Mae'n debyg na fo disg yng ngyrrwr %1"

#: kio_floppy.cpp:368
#, fuzzy
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"\n"
"Sicrhewch fod y pecyn mtools wedi'i osod yn gywir ar eich cysawd."

#~ msgid "Reason unknown."
#~ msgstr "Rheswm anhysbys."
