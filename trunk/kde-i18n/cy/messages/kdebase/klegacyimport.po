#: legacyimport.cpp:23
msgid ""
"<QT><b>Legacy Theme Importer</b><P>KDE now supports utilizing older themes "
"from other platforms in your new KDE desktop. The most common type of legacy "
"theme is for the GTK toolkit, which is imported to KDE's Control Center with "
"this utility.<P>In order to do this you must specify at least one item: the "
"folder where the pixmaps for the theme is located. You may also have to "
"specify the theme's gtkrc file if it's not in the same folder as the "
"pixmaps. Both are usually in the folder \"gtk\" inside the theme's directory."
"</QT>"
msgstr ""
"<QT><b>Mewnforiwr Hen Gynlluniau</b><P>Mae KDE yn cynnal defnyddio hen "
"gynlluniau o blatfformau eraill ar eich penbwrdd newydd KDE nawr. Y math mwyaf "
"cyffredin o hen gynlluniau yw rhai'r blwch offer GTK, a fewnforir i Ganolfan Reoli KDE "
"drwy'r cyfleuster yma.<P> Er mwyn gwneud hyn rhaid i chi benodi o leiaf un eitem: "
"y blygell lle lleolir picsfapiau'r cyllun. Efallai bydd raid i chi hefyd benodi ffeil gtkrc y "
"cynllun os nad yw yn yr un blygell â'r picsfapiau. Mae'r ddau fel arfer yn y blygell "
"\"gtk\" o fewn cyfeiriadur y cynllun. "
"</QT>"

#: legacyimport.cpp:33
msgid "Step 1: Specify theme's pixmap folder:"
msgstr "Cam 1: Penodi plygell picsfapiau'r cynllun:"

#: legacyimport.cpp:51
msgid "Specify pixmap Directory"
msgstr "Penodwch Gyfeiriadur y picsfapiau"

#: legacyimport.cpp:55
msgid ""
"<QT><b>Legacy Theme Importer</b><P>A gtkrc file was not found in the "
"specified directory. If it exists somewhere other than where the pixmaps are "
"located enter it here.</QT>"
msgstr ""
"<QT><b>Mewnforiwr Hen Gynlluniau</b><P>Ni ganfuwyd ffeil gtkrc yn y "
"cyfeiradur a benodwyd. Os yw'n bodoli rywle heblaw am lle lleolir y picsfapiau "
"rhowch ef yma.</QT>"

#: legacyimport.cpp:59
msgid "Step 2: Specify theme's gtkrc:"
msgstr "Cam 2: Penodi gtkrc y cynllun:"

#: legacyimport.cpp:76
msgid "Specify gtkrc Directory"
msgstr "Penodwch Gyfeiriadur gtkrc"

#: legacyimport.cpp:85
msgid "Legacy Import"
msgstr "Mewnforio Hen Gynlluniau"

#: legacyimport.cpp:92
msgid "GTK Themes Folder"
msgstr "Plygell Gynlluniau GTK"

#: legacyimport.cpp:116 legacyimport.cpp:137
msgid "You did not enter a valid file!"
msgstr "Ni roddoch ffeil ddilys!"

#: legacyimport.cpp:124
msgid "Gtkrc Theme File"
msgstr "Ffeil Gynllun Gtkrc"

#: legacyimport.cpp:143
msgid "Theme Title"
msgstr "Teitl y Cynllun"

#: legacyimport.cpp:144
msgid "Please enter a short title for this theme:"
msgstr "Rhowch deitl byr i'r cynllun yma:"

#: legacyimport.cpp:151
msgid "Legacy widget theme"
msgstr "Hen gynllun celfigion"

#: legacyimport.cpp:157
msgid "The theme is now installed and will be shown in KDE's Control Center."
msgstr "Mae'r cynllyn wedi'i osod yn awr ac fe'i ddengys yng Nghanolfan Reoli KDE."

#: legacyimport.cpp:164
msgid "KLegacyImport"
msgstr "KLegacyImport"

#: legacyimport.cpp:165
msgid "Importer for legacy themes"
msgstr "Mewnforiwr hen gynlluniau"

