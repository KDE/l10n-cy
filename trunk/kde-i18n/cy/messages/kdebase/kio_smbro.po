#: kio_smb.cpp:1298 kio_smb.cpp:1348 kio_smb.cpp:1471 kio_smb.cpp:1503
#, c-format
msgid ""
"\n"
"Could not create required pipe %1."
msgstr ""
"\n"
"Methwyd creu'r bibell angenrheidiol %1."

#: kio_smb.cpp:1335
msgid ""
"To be able to write to a remote Samba share you must patch and recompile "
"smbclient.\n"
"Visit http://lisa-home.sourceforge.net/smbclientpatch.html and follow the "
"instructions there."
msgstr ""
"I allu ysgrifennu i raniad pell Samba rhaid i chi glytio ag ail-grynhoi "
"smbclient.\n"
"Ymwelwch â http://list-home.sourceforge.net/smbclientpatch.html a dilynwch "
"y cyfarwyddiadau yno."

#: kio_smb.cpp:1358 kio_smb.cpp:1366 kio_smb.cpp:1514 kio_smb.cpp:1522
#, c-format
msgid ""
"\n"
"Could not fcntl() pipe %1."
msgstr ""
"\n"
"Methwyd fcntl() y bibell %1."
