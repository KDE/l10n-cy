#: main.cpp:48
msgid "KFM Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KFM Exec - Agor ffeiliau pell, arsylwi newidiadau, gofyn am fyny-lwytho"

#: main.cpp:54
msgid "Treat URLs as local files and delete them afterwards"
msgstr "Trin URLau fel ffeiliau a'u dileu wedyn"

#: main.cpp:55
msgid "Command to execute"
msgstr "Gorchymyn i'w weithredu"

#: main.cpp:56
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URL(au) neu ffeil(iau) lleol i'w defnyddio am 'gorchymyn'"

#: main.cpp:72
msgid "'command' expected.\n"
msgstr "'gorchymyn' a ddisgwylir.\n"

#: main.cpp:96
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"Mae'r URL %1\n"
"yn annilys"

#: main.cpp:98
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Nid yw'r URL pell %1\n"
"i'w ddefnyddio efo'r dywediad --tempfiles"

#: main.cpp:218
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Mae'r ffeil dros dro (fel y tybir)\n"
"%1\n"
"wedi'i addasu.\n"
"Ydych eisiau ei ddileu?"

#: main.cpp:219 main.cpp:226
msgid "File Changed"
msgstr "Ffeil wedi Newid"

#: main.cpp:225
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Mae'r ffeil\n"
"%1\n"
"wedi'i addasu.\n"
"Ydych eisiau fyny-lwytho'r newidiadau?"

#: main.cpp:253
msgid "KFMExec"
msgstr "KFMExec"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "KGyfieithu"

#: _translatorinfo.cpp:3
msgid ""
