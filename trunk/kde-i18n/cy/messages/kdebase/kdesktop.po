#: lock/lockdlg.cc:75
msgid "<nobr><b>The screen is locked</b><br>"
msgstr "<nobr><b>Mae'r sgrîn wedi'i gloi</b><br>"

#: lock/lockdlg.cc:76
msgid "<nobr><b>The screen is locked by %1</b><br>"
msgstr "<nobr><b>Mae'r sgrîn wedi'i gloi gan %1</b><br>"

#: lock/lockdlg.cc:86
msgid "&Start New Session"
msgstr "Dechrau &Sesiwn Newydd"

#: lock/lockdlg.cc:186
msgid "<b>Unlocking failed</b>"
msgstr "<b>Methwyd datgloi</b>"

#: lock/lockdlg.cc:192
msgid "<b>Warning: Caps Lock on</b>"
msgstr "<b>Rhybudd: Clo Llythrennau arnodd</b>"

#: lock/lockdlg.cc:416
msgid ""
"Cannot unlock the screen, as the authentication system fails to work.\n"
"You must kill kdesktop_lock (pid %1) manually."
msgstr ""
"Methu datgloi'r sgrîn, gan fod y cysawd dilysiant yn methu gweithio.\n"
"Rhaid i chi ladd kdesktop_lock (pid %1) â llaw."

#: lock/lockdlg.cc:489
msgid ""
"You have chosen to open another desktop session instead of resuming the "
"current one."
"<br>The current session will be hidden and a new login screen will be "
"displayed."
"<br>An F-key is assigned to each session; F%1 is usually assigned to the "
"first session, F%2 to the second session and so on. You can switch between "
"sessions by pressing CTRL, ALT and the appropriate F-key at the same time."
msgstr ""
"Rydych chi wedi dewis i agor penbwrdd arall yn lle aros gyda'r un "
"cyfredol."
"<br>"
"Mi fydd y sesiwn cyfredol yn cael ei guddio a mi fydd sgrîn mewngofnodi "
"newydd yn cael ei ddangos."
"<br>Mae allwedd-F yn cael ei neilltuo i bob sesiwn;  mae F%1 yn cael ei "
"neilltuo fel arfer i'r sesiwn cyntaf, F%2 i'r ail sesiwn, ac yn y blaen.  "
"Cewch newid rhwng sesiynau gan wthio CTRL, ALT a'r allwedd-F addas yr un "
"pryd."

#: lock/lockprocess.cc:651
msgid ""
"Will not lock the screen, as unlocking would be impossible:\n"
msgstr ""
"Ni fydd yn cloi'r sgrîn, oherwydd buasai datgloi yn amhosibl:\n"

#: lock/lockprocess.cc:655
msgid "Cannot start <i>kcheckpass</i>."
msgstr "Methu cychwyn <i>kcheckpass</i>."

#: lock/lockprocess.cc:656
msgid "<i>kcheckpass</i> is unable to operate. Possibly it is not SetUID root."
msgstr ""
"Mae <i>kcheckpass</i> yn methu gweithredu.  Efallai ni osodir i SetUID "
"gwraidd."

#: lock/lockprocess.cc:700
msgid "No appropriate greeter plugin configured."
msgstr "Ni ffurfweddir ategyn cyfarchydd penodol."

#: lock/main.cc:51
