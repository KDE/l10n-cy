#: smbmounterplugin.cpp:38
msgid "Smb&mount Current Share"
msgstr "Smb&glymu 'r Rhaniad Gyfredol"

#: smbmounterplugin.cpp:40
msgid "Smb&umount Current Share"
msgstr "Smb&ddatglymu 'r Rhaniad Gyfredol"

#: smbmounterplugin.cpp:136
msgid "<qt>Mounting of share <b>%1</b> from host <b>%2</b> failed.</qt>"
msgstr "<qt>Methodd clymu'r rhaniad <b>%1</b> o weinydd <b>%2</b>.</qt>"

#: smbmounterplugin.cpp:138
msgid ""
"<qt>The share <b>%1</b> from host <b>%2</b> has been mounted under <b>%3</b>."
"</qt>"
msgstr "<qt>Clymwyd y rhaniad <b>%1</b> o weinydd <b>%2</b> dan <b>%3</b>.</qt>"

#: smbmounterplugin.cpp:145
msgid "<qt>Umounting of share <b>%1</b> from host <b>%2</b> failed.</qt>"
msgstr "<qt>Methodd datglymu'r rhaniad <b>%1</b> o weinydd <b>%2</b>.</qt>"

#: smbmounterplugin.cpp:147
msgid ""
"<qt>The share <b>%1</b> from host <b>%2</b> has been umounted from <b>%3</"
"b></qt>."
msgstr "<qt>Datglymwyd y rhaniad <b>%1</b> o weinydd <b>%2</b> o <b>%3</b>.</qt>"

