#: kcmmediacontrol.cpp:197
msgid ""
"<h1>MediaControl</h1> This module allows you to configure the MediaControl "
"applet for KDE's panel."
msgstr ""
"<h1>RheoliCyfryngau</h1> Mae'r modiwl yma'n eich galluogi i ffurfweddu'r "
"rhaglennig RheoliCyfryngau ar gyfer panel KDE."

#: rc.cpp:1
msgid "KCMMediaControlWidget"
msgstr "CelfigynRheoliCyfryngauKCM"

#: rc.cpp:4
msgid "General"
msgstr "Cyffredinol"

#: rc.cpp:5
msgid "Media-Player"
msgstr "Chwareuydd-Cyfryngau"

#: rc.cpp:6
msgid "Select the multimedia-player you are using in this box"
msgstr "Dewiswch y chwareuydd aml-gyfrwng rydych yn ei ddefnyddio yn y blwch yma"

#: rc.cpp:8
msgid "Mousewheel scrolling amount:"
msgstr "Maint sgrolio olwyn y llygoden:"

#: rc.cpp:9
msgid "Sets the amount a mousewheel will scroll in the current file"
msgstr "Gosod faint fydd olwyn y llygoden yn sgrolio yn y ffeil presennol"

#: rc.cpp:10
msgid "Themes"
msgstr "Themâu"

#: rc.cpp:11
