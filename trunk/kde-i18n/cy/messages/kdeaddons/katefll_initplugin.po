#: katefll_plugin.cpp:73
msgid "Open File List..."
msgstr "Agor y Rhestr Ffeiliau..."

#: katefll_plugin.cpp:77
msgid "Save File List"
msgstr "Cadw'r Rhestr Ffeiliau"

#: katefll_plugin.cpp:81
msgid "Save File List As..."
msgstr "Cadw'r Rhestr Ffeiliau Fel..."

#: katefll_plugin.cpp:123
msgid ""
"<qt>"
"Since the last time you saved the file list, Kate has been reinitialized by "
"another plugin other than the <B>File List Loader</B>. Do you still want to "
"save the list to %1?</qt>"
msgstr ""
"<qt>Ers y tro diwethaf y wnaethoch gadw'r rhestr ffeiliau, mae Kate wedi'i "
"hail-ymgychwyn gan ategyn arall heblaw y <B>Llwythydd Rhestr Ffeiliau</B>. "
"Serch hynny, ydych eisiau cadw'r rhestr i %1?</qt>"

#: katefll_plugin.cpp:137
msgid ""
"<qt>Kate has been reinitialized by another plugin other than the <B>File "
"List Loader</B>. Do you still want to save the list to %1?</qt>"
msgstr ""
"<qt>Mae Kate wedi'i hail-ymgychwyn gan ategyn arall heblaw y <B>Llwythydd "
"Rhestr Ffeiliau</B>. Serch hynny, ydych eisiau cadw'r rhestr i %1?</qt>"

#: rc.cpp:2
msgid "&Filelist"
msgstr "&Rhestr Ffeiliau"
