msgid "VNC-compatible server to share KDE desktops"
msgstr "Gweinydd VNC-gytûn i rannu penbyrddau KDE"

#: main.cpp:51
msgid "Used for calling from kinetd."
msgstr "Defnyddir ar gyfer galw o kinetd."

