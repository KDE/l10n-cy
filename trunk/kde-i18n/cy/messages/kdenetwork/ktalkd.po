msgstr "&Profi"

#: ../kcmktalkd/soundpage.cpp:110
msgid "Additional WAV files can be dropped onto the sound list."
msgstr "Gellir gollwng ffeiliau WAV ychwanegol ar y restr seiniau."

#: ../kcmktalkd/soundpage.cpp:192
msgid "This type of URL is currently unsupported by the KDE System Sound Module"
msgstr "Ni chynhelir y math yma o URL gan y Modiwl Sain Cysawd KDE ar hyn o bryd."

#: ../kcmktalkd/soundpage.cpp:194
msgid "Unsupported URL"
msgstr "URL nas cynhelir"

#: ../kcmktalkd/soundpage.cpp:199
msgid ""
"%1\n"
"does not appear to be a WAV file."
msgstr ""
"Nid yw %1\n"
" i'w weld yn ffeil WAV."

#: ../kcmktalkd/soundpage.cpp:202
msgid "Improper File Extension"
msgstr "Estyniad Ffeil Anghywir"

#: ../kcmktalkd/soundpage.cpp:210
