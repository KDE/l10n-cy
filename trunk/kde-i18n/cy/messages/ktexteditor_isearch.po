msgid ""
" _: Incremental Search found no match\n"
" Failing I-Search:\n"
msgstr "Methodd y chwiliad cynyddol ganfod cydweddiad: \n"

#: ISearchPlugin.cpp:273
msgid ""
" _: Incremental Search in the reverse direction\n"
" I-Search Backward:\n"
msgstr "Chwiliad cynyddol i'r cyfeiriad arall: \n"

#: ISearchPlugin.cpp:276
msgid "Failing I-Search Backward:"
msgstr "Methodd y chwiliad cynyddol ganfod cydweddiad yn y cyfeiriad arall:"

#: ISearchPlugin.cpp:279
msgid ""
" _: Incremental Search has passed the end of the document\n"
" Wrapped I-Search:\n"
msgstr "Mae'r chwiliad cynyddol wedi pasio diwedd y ddogfen:\n"

#: ISearchPlugin.cpp:282
msgid "Failing Wrapped I-Search:"
msgstr "Methodd y chwiliad cynyddol ganfod cydweddiad ar ôl pasio diwedd y ddogfen"

