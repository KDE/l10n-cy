#: imageeffect_lensdistortion.cpp:384
msgid ""
"<p>This is the preview of the spherical aberration correction. If you move "
"the mouse cursor on this preview, a vertical and horizontal dashed line will "
"be draw to guide you in adjusting the lens distortion correction. Press the "
"left mouse button to freeze the dashed line's position."
msgstr ""

#: imageeffect_lensdistortion.cpp:394
msgid "Settings"
msgstr "Gosodiadau"

#: imageeffect_lensdistortion.cpp:399
msgid ""
"<p>"
"You can see here a thumbnail preview of the distortion correction applied to "
"a cross pattern."
msgstr ""

#: imageeffect_lensdistortion.cpp:403
msgid "Main:"
msgstr "Prif :"

#: imageeffect_lensdistortion.cpp:411
msgid ""
"<p>This value controls the amount of distortion. Negative values correct "
"lens barrel distortion, while positive values correct lens pincushion "
"distortion."
msgstr ""

#: imageeffect_lensdistortion.cpp:421
msgid "Edge:"
msgstr "Ymyl :"

#: imageeffect_lensdistortion.cpp:429
msgid ""
"<p>This value controls in the same manner as the Main control, but has more "
"effect at the edges of the image than at the center."
msgstr ""

#: imageeffect_lensdistortion.cpp:439
msgid "Zoom:"
msgstr "Chwyddo:"

#: imageeffect_lensdistortion.cpp:447
msgid "<p>This value rescales the overall image size."
msgstr ""

#: imageeffect_lensdistortion.cpp:455
msgid "Brighten:"
msgstr ""

#: imageeffect_lensdistortion.cpp:464
msgid "<p>This value adjust the brightness in image corners."
msgstr ""

