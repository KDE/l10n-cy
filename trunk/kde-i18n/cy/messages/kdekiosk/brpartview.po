#: konq_run.cc:145
msgid ""
"There appears to be a configuration error. You have associated Konqueror "
"with %1, but it cannot handle this file type."
msgstr "Ymddengys bod gwall ffurfweddu.  Rydych wedi cysylltu Konqueror efo %1, ond ni all drin y math yma o ffeil."

#: konq_run.cc:266
msgid "Do you really want to execute '%1'?"
msgstr "Ydych wir eisiau gweithredu '%1'?"

#: konq_run.cc:280
msgid "Open '%1' using '%2'?"
msgstr "Agor '%1' gan ddefnyddio '%2'?"

#: konq_run.cc:282
msgid "Open '%1'?"
msgstr "Agor '%1'?"

#: konq_run.cc:285
msgid "Save to Disk"
msgstr "Cadw i Ddisg"

