msgid ""
"Machine code display\n"
"\n"
"A machine code view into your running executable with the current "
"instruction highlighted. You can step instruction by instruction using the "
"debuggers toolbar buttons of \"step over\" instruction and \"step into\" "
"instruction."
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:111
msgid "debugger disassemble"
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:149
