msgid "Interrupts the application"
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:172
msgid "Steps over the next line"
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:173
msgid ""
"Step over\n"
"\n"
"Executes one line of source in the current source file. If the source line "
"is a call to a function the whole function is executed and the app will stop "
"at the line following the function call."
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:183
msgid "Steps into the next statement"
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:184
msgid ""
"Step into\n"
"\n"
"Executes exactly one line of source. If the source line is a call to a "
"function then execution will stop after the function has been entered."
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:193
msgid "Steps into the next assembly instruction"
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:200
msgid ""
"Step out of\n"
"\n"
"Executes the application until the currently executing function is "
"completed. The debugger will then display the line after the original call "
"to that function. If we are in the outermost frame (i.e. in main()), then "
"this operation has no effect."
msgstr ""

#: languages/java/debugger/javadebuggerpart.cpp:211
msgid "Various views into the application"
msgstr ""

