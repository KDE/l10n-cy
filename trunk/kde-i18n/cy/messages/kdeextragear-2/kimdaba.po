#: export.cpp:344
msgid ""
"<qt>"
"<p>Other KimDaBa users may now load the import file into their database, by "
"choosing <tt>import</tt> in the file menu.</p>"
"<p>If they find it on a web site, and the web server is correctly "
"configured, all they need to do is simply to click it from within konqueror. "
"To enable this, your web server needs to be configured for KimDaBa. You do "
"so by adding the following line to <tt>/etc/httpd/mime.types</tt> or "
"similar:"
"<pre>application/vnd.kde.kimdaba-import kim</pre>This will make your web "
"server tell konqueror that it is a KimDaBa fill when clicking on the link, "
"otherwise the web server will just tell konqueror that it is a plain text "
"file.</p></qt>"
msgstr ""

