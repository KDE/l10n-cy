msgstr "Yn anwybyddu ffeil Blygelli OE5+ %1"

#: filter_oe.cxx:121
msgid "File %1 doesn't seem to be an Outlook Express mailbox"
msgstr "Nid yw'r ffeil %1 i'w gweld yn flwch ebost Outlook Express"

