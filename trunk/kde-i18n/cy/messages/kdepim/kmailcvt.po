msgid "Import Thunderbird Local Mails and Folder Structure"
msgstr ""

#: filter_thunderbird.cxx:30
msgid ""
"<p><b>Thunderbird import filter</b></p>"
"<p>Select your base Thunderbird mailfolder (usually "
"~/.thunderbird/*.default/Mail/Local Folders/).</p>"
"<p><b>Note:</b> Never choose a Folder, which <u>does not</u> contain "
"mbox-files (for example a maildir). If you do it anyway, you will get many "
"new folders.</p>"
"<p>As it is currently impossible to recreate the folder structure, it will "
"be \"contained\" in the generated folder's names.</p>"
msgstr ""

