#: main.cpp:33
msgid "kabc2mutt"
msgstr "kabc2mutt"

#: main.cpp:34
msgid "kabc - mutt converter"
msgstr "trosiadydd kabc - mutt"

#: main.cpp:38
msgid "Only show contacts where name or address matches <substring>"
msgstr ""
"Dangos cysylltau lle mae'r enw neu gyfeiriad yn cydweddu â <substring> yn "
"unig"

#: main.cpp:39
msgid ""
"Default format is 'alias'. 'query' returns email<tab>name<tab>"
", as needed by mutt's query_command"
msgstr ""
"'Alias' yw'r fformat rhagosod.  Dychwela 'query' ebost<tab>enw<tab>, fel "
"gofynnir gan query_command mutt"

#: main.cpp:66
msgid "Searching KDE addressbook..."
msgstr "Chwilio yn y llyfr cyfeiriadau mutt..."
