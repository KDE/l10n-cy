#: kpgp.cpp:184
msgid ""
"Couldn't find PGP executable.\n"
"Please check your PATH is set correctly."
msgstr ""
"Methu canfod gweithredadwyn PGP.\n"
"Gwiriwch bod eich PATH wedi'i osod yn gywir."

#: kpgp.cpp:203
msgid "OpenPGP Security Check"
msgstr "Gwirio Diogelwch OpenPGP"

#: kpgp.cpp:210
msgid "Passphrase is too long, it must contain less than 1024 characters."
msgstr "Mae'r cyfrin-ymadrodd yn rhy hir, rhaid iddo gynnwys llai na 1024 nod."

#: kpgp.cpp:212
msgid "Out of memory."
msgstr "Allan o gof."

#: kpgp.cpp:282
msgid ""
"You just entered an invalid passphrase.\n"
"Do you want to try again, or cancel and view the message undecrypted?"
msgstr ""
"Rydych wedi mewnosod cyfrin-ymadrodd sy'n annilys.\n"
"Ydych eisiau ceisio eto, neu ddiddymu a gweld y neges heb ei chêl-ysgrifo?"

#: kpgp.cpp:285 kpgp.cpp:344 kpgp.cpp:373 kpgp.cpp:392 kpgp.cpp:418
