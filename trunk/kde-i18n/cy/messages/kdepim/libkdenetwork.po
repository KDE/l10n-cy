msgid "PGP Warning"
msgstr "Rhybudd PGP"

#: kpgp.cpp:285 kpgp.cpp:345
msgid "&Retry"
msgstr "&Ail-geisio"

#: kpgp.cpp:339
msgid ""
"You entered an invalid passphrase.\n"
"Do you want to try again, continue and leave the message unsigned, or cancel "
"sending the message?"
msgstr ""
"Rydych wedi mewnosod cyfrin-ymadrodd annilys.\n"
"Ydych eisiau ceisio eto, mynd ymlaen a gadael y neges heb ei llofnodi, neu "
"ddiddymu anfon y neges?"

#: kpgp.cpp:346 kpgp.cpp:374
msgid "Send &Unsigned"
msgstr "Anfon heb ei &Llofnodi"

#: kpgp.cpp:368
msgid ""
"_: %1 = 'signing failed' error message\n"
"%1\n"
"Do you want to send the message unsigned, or cancel sending the message?"
msgstr ""
"%1\n"
"Ydych eisiau anfon y neges heb ei llofnodi, neu ddiddymu anfon y neges?"

#: kpgp.cpp:386
msgid ""
"_: %1 = 'bad keys' error message\n"
"%1\n"
"Do you want to encrypt anyway, leave the message as is, or cancel sending "
"the message?"
msgstr ""
"%1\n"
"Ydych eisiau cêl-ysgrifo serch hynny, gadael y neges fel mae, neu ddiddymu "
"anfon y neges?"

#: kpgp.cpp:393 kpgp.cpp:605
msgid "Send &Encrypted"
msgstr "Anfon wedi'i &Chêl-ysgrifo "

#: kpgp.cpp:394 kpgp.cpp:586 kpgp.cpp:606
msgid "Send &Unencrypted"
msgstr "Anfon &heb ei Chêl-ysgrifo "

#: kpgp.cpp:413
msgid ""
"_: %1 = 'missing keys' error message\n"
"%1\n"
"Do you want to leave the message as is, or cancel sending the message?"
msgstr ""
"%1\n"
"Ydych eisiau gadael y neges fel mae, neu ddiddymu anfon y neges?"

#: kpgp.cpp:419
msgid "&Send as is"
msgstr "&Anfon fel mae"

