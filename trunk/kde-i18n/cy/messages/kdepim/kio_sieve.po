#: sieve.cpp:271
msgid "Connecting to %1..."
msgstr "Yn cysylltu â %1..."

#: sieve.cpp:274
msgid "The connection to the server was lost."
msgstr "Collwyd y cysylltiad â'r gweinydd.f"

#: sieve.cpp:286
msgid "Server identification failed."
msgstr "Methodd dynodi'r gweinydd."

#: sieve.cpp:313
msgid "Authenticating user..."
msgstr "Yn dilysu'r defnyddiwr..."

#: sieve.cpp:316
msgid "Authentication failed."
msgstr "Methodd y dilysu."

#: sieve.cpp:377 sieve.cpp:573 sieve.cpp:629 sieve.cpp:662
msgid "Done."
msgstr "Wedi'i wneud."

#: sieve.cpp:388
msgid "Activating script..."
msgstr "Yn gweithredoli sgript..."

#: sieve.cpp:404 sieve.cpp:422
msgid "There was an error activating the script."
msgstr "Bu gwall tra'n gweithredoli'r sgript."

#: sieve.cpp:432
msgid "Sending data..."
msgstr "Yn anfon data..."

#: sieve.cpp:460
msgid "KIO data supply error."
msgstr "Gwall darparu data KIO."

#: sieve.cpp:484
msgid "Quota exceeded"
msgstr "Aethpwyd dros y ddogn"

#: sieve.cpp:517 sieve.cpp:607 sieve.cpp:932
msgid "Network error."
msgstr "Gwall rhwydwaith."

#: sieve.cpp:528
msgid "Verifying upload completion..."
msgstr "Yn gwirio cyflawniad lanlwytho..."

#: sieve.cpp:554 
#, c-format
msgid ""
" The script did not upload successfully.\n"
" This is probably due to errors in the script.\n"
" The server responded:\n"
" %1\n"
msgstr ""
"Ni lanlwythodd y sgript yn llwyddiannus.\n"
" Mae'n debyg taw o achos gwallau yn y sgript mae hyn.\n"
" Ymatebodd y gweinydd:\n"
" %1\n"

#: sieve.cpp:562 sieve.cpp:566
msgid ""
" The script did not upload successfully.\n"
" The script may contain errors.\n"
msgstr ""
"Ni lanlwythodd y sgript yn llwyddiannus.\n"
" Gall fod gwallau yn y sgript.\n"

#: sieve.cpp:584
msgid "Retrieving data..."
msgstr "Yn nôl data..."

#: sieve.cpp:617
msgid "Finishing up..."
msgstr "Yn gorffen i fyny..."

#: sieve.cpp:624
msgid "A protocol error occurred while trying to negotiate script downloading."
msgstr "Digwyddodd gwall protocol tra'n ceisio trafod lawrlwytho sgript."

#: sieve.cpp:636
msgid "Directories are not supported."
msgstr "Ni chynhelir cyfeiriaduron."

#: sieve.cpp:643
msgid "Deleting file..."
msgstr "Yn dileu'r ffeil..."

#: sieve.cpp:658
msgid "The server would not delete the file."
msgstr "Gwrthododd y gweinydd ddileu'r ffeil."

#: sieve.cpp:677
msgid "Cannot chmod to anything but 0700 (active) or 0600 (inactive script)."
msgstr "Methu chmod i unrhywbeth heblaw am 0700 (gweithredol) neu 0600 (sgript anweithredol)"

#: sieve.cpp:823
msgid "Sieve Authentication Details"
msgstr "Manylion Dilysu Rhidyll"

#: sieve.cpp:824
msgid " Please enter your authentication details for your sieve account (usually the same as your email password):"
msgstr "Rhowch eich manylion dilysu ar gyfer eich cyfrif ridyll (fel arfer yr un fath a'ch cyfrinair ebost):"

#: sieve.cpp:827
msgid "No authentication details supplied."
msgstr "Ni ddarperwyd manylion dilysu."

#: sieve.cpp:846
msgid "No compatible authentication methods found."
msgstr "Ni ganfuwyd dulliau dilysu cyfaddas."

#: sieve.cpp:865 sieve.cpp:877 
#, c-format
msgid ""
" A protocol error occurred during authentication.\n"
" Choose a different authentication method to %1.\n"
msgstr ""
"Digwyddodd gwall protocol yn ystod y dilysu.\n"
" Dewiswch dull dilysu sy'n wahanol i %1.\n"

#: sieve.cpp:903 
#, c-format
msgid ""
" Authentication failed.\n"
" Most likely the password is wrong.\n"
" The server said:\n"
" %1\n"
msgstr ""
"Methodd y dilysu.\n"
" Mwy na thebyg mae'r cyfrinair yn anghywir.\n"
" Dywedodd y gweinydd:\n"
" %1\n"

#: sieve.cpp:978
msgid "A protocol error occurred."
msgstr "Digwyddodd gwall protocol."


