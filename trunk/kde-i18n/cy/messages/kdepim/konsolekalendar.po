msgid "Invalid Export Type Specified: "
msgstr "Penodwyd Math Allforio Annilys:"

#: main.cpp:344
msgid "Invalid Start Date Specified: "
msgstr "Penodwyd Dyddiad Dechrau Annilys:"

#: main.cpp:362
msgid "Invalid Start Time Specified: "
msgstr "Penodwyd Amser Dechrau Annilys:"

#: main.cpp:380
msgid "Invalid End Date Specified: "
