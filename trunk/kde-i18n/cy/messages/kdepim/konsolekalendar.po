#: main.cpp:50
msgid "End time in epoch format"
msgstr "Amser gorffen yn y ffurf oesol"

#: main.cpp:51
msgid "Start time in epoch format"
msgstr "Amser cychwyn yn y ffurf oesol"

#: main.cpp:52
