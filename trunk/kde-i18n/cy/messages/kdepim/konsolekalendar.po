msgstr "Allbynnu gwybodaeth dadnamu o gymorth (?)"

#: main.cpp:42
msgid "Specify which calendar you want to use."
msgstr "Penodwch pa galendr yr ydych am ddefnyddio."

#: main.cpp:43
msgid "Next activity in calendar"
msgstr "Gweithgaredd nesaf yn y calendr"

#: main.cpp:44
msgid "Show selected day's calendar"
msgstr "Dangos calendr y diwrnod dewisiedig"

#: main.cpp:45
msgid "Show selected time at calendar"
msgstr "Dangos yr amser dewisiedig wrth y calendr"

#: main.cpp:46
msgid "Start from this day"
msgstr "Dechrau o'r diwrnod yma"

#: main.cpp:47
msgid "Start from this time [mm:hh]"
