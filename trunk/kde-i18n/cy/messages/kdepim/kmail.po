#, no-c-format
msgid "Opa&que (only recommended for SPHINX)"
msgstr "Af&loyw (argymhellir ar gyfer SPHINX yn unig)"

#. i18n: file signatureconfigurationdialog.ui line 347
#: rc.cpp:731
#, no-c-format
