msgstr "&Cau'r cyfrifiadur i lawr"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 120
#: rc.cpp:49
msgid "&Restart computer"
msgstr "&Ail-gychwyn y cyfrifiadur"

