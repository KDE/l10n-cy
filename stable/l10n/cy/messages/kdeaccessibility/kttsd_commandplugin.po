#, no-c-format
msgid ""
"Parameters:\n"
"  %t: Text to be spoken\n"
"  %f: Filename of a temporary file containing the text\n"
"  %l: Language (two letter code)\n"
"  %w: Filename of a temporary file for generated audio"
msgstr ""
