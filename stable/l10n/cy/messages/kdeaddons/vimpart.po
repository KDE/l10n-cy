#: vimpart_shell.cpp:39
msgid "&Open File..."
msgstr "&Agor Ffeil..."

#: vimpart_shell.cpp:119
msgid "No libvimpart found."
msgstr "libvimpart heb ei ganfod."

#: vimpart_shell.cpp:148
msgid "Files to load"
msgstr "Ffeiliau i'w llwytho"

#: vimpart_shell.cpp:152
msgid "Test Shell for the vim kpart."
msgstr "Plisgyn Profi i'r vim kpart."

#: vimview.cpp:138
msgid "Save the current document"
msgstr "Cadw'r ddogfen cyfredol"

#: vimview.cpp:142
msgid "Revert the most recent editing actions"
msgstr "Dychwelyd y gweithredoedd golygu diweddaraf"

#: vimview.cpp:146
msgid "Revert the most recent undo operation"
msgstr "Dychwelyd y weithred ddadwneud diweddaraf"

#: vimview.cpp:150
msgid "Cut the selected text and move it to the clipboard"
msgstr "Torri'r testun dewisiedig a'i symud i'r gludfwrdd"

#: vimview.cpp:154
msgid "Paste previously copied or cut clipboard contents"
msgstr "Gludo cynhwysion y gludfwrdd sydd wedi eu gopïo neu dorri ynghynt"

#: vimview.cpp:159
msgid "Closes the current document."
msgstr "Cau'r ddogfen gyfredol."

#: vimview.cpp:163
msgid ""
"Use this command to copy the currently selected text to the system clipboard."
msgstr "Defnyddiwch y gorchymyn yma i gopïo'r testun dewisiedig i'r gludfwrdd."

#: vimview.cpp:167
msgid "Save the current document to disk, with a name of your choice."
msgstr "Cadw i ddisg y ddogfen gyfredol gyda enw o'ch dewis chi."

#: vimview.cpp:171
msgid ""
"This command opens a dialog and lets you choose a line that you want the cursor "
"to move to."
msgstr ""
"Mae'r gorchymyn yma'n agor blwch ymgom i ddewis pa linell i symud y cyrchydd "
"iddi."

#: vimview.cpp:175
msgid "Select the entire text of the current document."
msgstr "Dewis holl destun y ddogfen gyfredol."

#: vimview.cpp:179
msgid "Find text in the current document."
msgstr "Canfod testun yn y ddogfen gyfredol."

#: vimwidget.cpp:83 vimwidget.cpp:93
msgid "Please use the KDE control module and configure the Vim component."
msgstr "Defnyddiwch y modiwl rheoli KDE i ffurfweddu'r cydran Vim."

#: vimwidget.cpp:83 vimwidget.cpp:93 vimwidget.cpp:102 vimwidget.cpp:110
#: vimwidget.cpp:117
msgid "Vim Error"
msgstr "Gwall Vim"

#: vimwidget.cpp:98
msgid ""
"\n"
"Unable to start the Vim editing control. Use the KDE Control Center to "
"reconfigure and test your Vim component.\n"
msgstr ""
"\n"
"Methu cychwyn rheolaeth golygu Vim. Defnyddiwch y Ganolfan Reoli KDE er mwyn "
"ailffurfweddu neu brofi eich cydran Vim.\n"

#: vimwidget.cpp:101
msgid ""
"Please use the KDE control module and configure the Vim component.\n"
msgstr ""
"Defnyddiwch y modiwl rheoli KDE i ffurfweddu'r cydran Vim.\n"

#: vimwidget.cpp:109
msgid ""
"Vim executable '%1' does not exist or is not accessible.\n"
msgstr ""
"Nid yw'r gweithredadwyn Vim '%1' ddim yn bodoli neu mae'n anhygyrch.\n"

#: vimwidget.cpp:116
msgid ""
"Vim executable '%1' is not executable.\n"
msgstr ""
"Nid yw'r rhaglen Vim '%1' ddim yn weithredadwy.\n"

#: xvim_win.cpp:25
msgid "Select Mode"
msgstr "Dewis Modd"

#: xvim_win.cpp:27
msgid "Evaluate expressions"
msgstr "Gwerthuso Ymadroddion"

#: xvim_win.cpp:29
msgid "Send keys"
msgstr "Anfon bysyll"

