#: SpellPlugin.cpp:101
msgid "Spellcheck"
msgstr "Gwirio Sillafu"

#: SpellPlugin.cpp:179
msgid ""
"ISpell could not be started. Please make sure you have ISpell properly "
"configured and in your PATH."
msgstr ""
"Ni allwyd cychwyn ISpell.  Sicrhewch bod ISpell wedi'i ffurfweddu'n iawn ac yn "
"eich PATH."

#: SpellPlugin.cpp:185
msgid "ISpell seems to have crashed."
msgstr "Ymddengys bod ISpell wedi chwalu."

#: SpellPlugin.h:64
msgid "Spelling"
msgstr "Sillafu"

#: SpellPlugin.h:65
msgid "Spell Checker Behavior"
msgstr "Ymddygiad y Gwirydd Sillafu"
